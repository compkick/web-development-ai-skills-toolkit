{
  "name": "dev-docs-and-checklists",
  "private": true,
  "version": "0.0.1",
  "description": "Validation tooling for the web development documentation library.",
  "scripts": {
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "docs:links": "node scripts/check-doc-links.mjs",
    "docs:links:internal": "node scripts/check-doc-links.mjs --internal-only",
    "docs:links:external": "node scripts/check-doc-links.mjs --external-only",
    "docs:check": "npm run docs:lint && npm run docs:links",
    "skills:refs": "node scripts/sync-skill-references.mjs",
    "skills:refs:check": "node scripts/sync-skill-references.mjs --check",
    "runtime:bootstrap": "node plugins/web-dev-checklists/runtime/scripts/bootstrap.mjs",
    "runtime:audit": "node plugins/web-dev-checklists/runtime/scripts/audit.mjs",
    "runtime:check": "node scripts/check-audit-runtime.mjs",
    "runtime:test": "node plugins/web-dev-checklists/runtime/scripts/test-runtime.mjs",
    "review:website": "node plugins/web-dev-checklists/runtime/scripts/review.mjs",
    "reviews:check": "node scripts/check-review-runner.mjs",
    "reviews:test": "npm run reviews:test-accessibility && npm run reviews:test-security",
    "reviews:test-accessibility": "node plugins/web-dev-checklists/runtime/scripts/test-review-runner.mjs",
    "reviews:test-security": "node plugins/web-dev-checklists/runtime/scripts/test-security-review-runner.mjs",
    "deps:audit": "npm audit --audit-level=high && npm audit --prefix plugins/web-dev-checklists/runtime --audit-level=high",
    "repo:check": "npm run docs:check && npm run skills:refs:check && npm run runtime:check && npm run reviews:check && npm run deps:audit"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.2"
  },
  "overrides": {
    "markdown-it": "14.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
