{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:web-dev-checklists:schema:review-coverage:1",
  "title": "Web Dev Checklists automation coverage",
  "type": "object",
  "required": ["schemaVersion", "profile", "checklistSource", "items"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "profile": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "checklistSource": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "section", "checklistItem", "automation", "evidenceCheckIds", "note"],
        "properties": {
          "id": { "type": "string" },
          "section": { "type": "string" },
          "checklistItem": { "type": "string" },
          "automation": { "enum": ["automated", "partial", "manual"] },
          "evidenceCheckIds": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
